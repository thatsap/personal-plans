# Required. Supabase → Project Settings → API.
# Use the anon public key or the publishable key.
# Never put the service_role key or a secret key here. It would ship in the website.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Optional. Shown on the cover and in the browser tab after the app loads.
# The first paint title lives in index.html.
# VITE_SITE_TITLE=Chapbook
# VITE_SITE_KICKER=A private collection
# VITE_SITE_LEDE=A quiet room for poems. Read slowly. The page will wait.
