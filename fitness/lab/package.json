{
  "name": "personal-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5174",
    "local": "vite --host --port 5174",
    "start": "vite --host --port 5174",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host --port 4174",
